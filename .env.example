# Backend API URL
# Local development: http://127.0.0.1:8000
# Production: https://your-render-backend.onrender.com
VITE_API_URL=http://127.0.0.1:8000

# Supabase Cloud Storage & Database Credentials
# Leave empty to automatically run in Local Preview / SQLite mode without errors.
# To connect to Supabase:
# 1. Provide your project URL & Anon Public Key below
# 2. Create a public storage bucket named "wafer-inspections"
# 3. Create a table named "inspections"
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

